#include <iostream>
#include <string>
#include <vector>
using namespace std;
class Persona {
    private:
        string nombre;
        float edad;
        int altura;
    public:
        Persona(string nombre, int edad, float altura)
        : nombre(nombre), edad(edad), altura(altura) {}
        string getNombre() const { return nombre; }
        float getEdad() const { return edad; }
        float getAltura() const { return altura; }
};
int main() {
    vector<Persona> personas;
    string nombre;
    int edad;
    float altura;
    int numero_personas;
    cout << "Ingrese el numero de empleados: ";
    cin >> numero_personas;
    for (int i = 0; i < numero_personas; i++) {
        cout << "Ingrese el nombre del empleado numero " << i+1 << ": ";
        cin >> nombre;
        cout << "Ingrese el salario: ";
        cin >> edad;
        cout << "Ingrese el departamento:  ";
        cin >> altura;
        personas.push_back(Persona(nombre, edad, altura));
    }
    for (int k = 1; k < personas.size(); k++) {
        Persona actual = personas[k];
        int auxiliar = k - 1;
        while (auxiliar >= 0 && personas[auxiliar].getEdad() < actual.getEdad()) {
            personas[auxiliar + 1] = personas[auxiliar];
            auxiliar--;
        }
        personas[auxiliar + 1] = actual;
    }
    cout << endl << "Datos en orden de salario de mayor a menor:";
    for (const auto& Persona : personas) {
        cout << endl << "Nombre: " << Persona.getNombre() << endl;
        cout << "Salario: " << Persona.getEdad() << " pesos" << endl;
        cout << "Departamento: " << Persona.getAltura() << endl << endl;
    }
    return 0;
}









