#include <iostream>
#include <string>
#include <vector>
using namespace std;
class Rectangulo {
    private:
        float base;
        float altura;
    public:
        Rectangulo(float base, float altura)
        : base(base), altura(altura) {}
        float getBase() const { return base; }
        float getAltura() const { return altura; }
        double calcularPerimetro() const { return ((base * 2) + (altura * 2)); }
        double calcularArea() const { return (base * altura); }
};
int main() {
    vector<Rectangulo> rectangulos;
    float base, altura;
    int numeros_rectangulos;
    cout << "Ingrese el numero de rectangulos: ";
    cin >> numeros_rectangulos;
    for (int i = 0; i < numeros_rectangulos; i++) {
        cout << "Ingrese la base del rectangulo numero " << i+1 << ": ";
        cin >> base;
        cout << "Ingrese la altura del rectangulo numero: ";
        cin >> altura;
        rectangulos.push_back(Rectangulo(base, altura));
        cout << endl;
    }
    cout << endl << "Datos de los rectangulos:" << endl;
    for (const auto& Rectangulo : rectangulos) {
        cout << "Base: " << Rectangulo.getBase() << endl;
        cout << "Altura: " << Rectangulo.getAltura() << endl;
        cout << "Perimetro: " << Rectangulo.calcularPerimetro() << endl;
        cout << "Area: " << Rectangulo.calcularArea() << endl;
        cout << endl;
    }
    return 0;
}
